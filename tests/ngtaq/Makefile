	cd /home/kpango/go/src/github.com/kpango/NGT && $(MAKE) $(MAKESILENT) -f tests/ngtaq/CMakeFiles/test_vector_record.dir/build.make tests/ngtaq/CMakeFiles/test_vector_record.dir/test_vector_record.cpp.s
.PHONY : test_vector_record.cpp.s

